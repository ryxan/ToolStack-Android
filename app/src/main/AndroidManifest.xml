<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera is used for the recipe scan feature but is not required to run the app -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".IndustrialUtilityApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IndustrialUtility"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IndustrialUtility.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link scheme for home screen shortcuts.
                 toolstack://screen/{route} routes to a specific tool screen.
                 autoVerify is false — no Digital Asset Links file is needed
                 because shortcuts are created programmatically by this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="toolstack"
                    android:host="screen" />
            </intent-filter>
        </activity>

        <!--
            FileProvider supplies a content:// URI for the camera photo created by
            TakePicture. The authority must be unique to the app; we qualify it with
            the applicationId so debug (.debug suffix) and release don't collide.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
